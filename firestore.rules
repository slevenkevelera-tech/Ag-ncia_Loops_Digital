rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && incoming().uid == request.auth.uid;
      allow delete: if false;
    }

    // CRM Leads collection: read/write for authenticated users, create also allowed for web visitors
    match /leads/{leadId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 128;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Chat sessions
    match /chat_conversations/{conversationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'anonymous');
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'anonymous');
      allow create: if isSignedIn() || incoming().userId == 'anonymous';
      allow update: if isSignedIn() || incoming().userId == 'anonymous';
      allow delete: if isSignedIn();
    }
  }
}
